# Matches the Docker database in the README. Change these for any other database.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=booked

# Optional
# PORT=4000
# IS_PROD=true
# DB_POOL_MAX=5

# Server only: which image docker-compose runs (dev or prod). On the server,
# also set a strong DB_PASSWORD; docker-compose sets DB_HOST and DB_PORT itself.
# BOOKED_ENV=prod
